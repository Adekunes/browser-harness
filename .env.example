# Copy to .env — auto-loaded. Only needed for remote browsers.
BROWSER_USE_API_KEY=bu_your_key_here

# Optional. IPC response budget (seconds) for every CDP command the helpers send
# to the daemon. Default 30 (screenshots 60). Raise it for pages with very slow
# navigations or long awaited promises; lower it to fail fast. Individual calls
# can override with cdp(..., _response_timeout=N) / js(..., timeout=N).
# BH_CMD_TIMEOUT=30
